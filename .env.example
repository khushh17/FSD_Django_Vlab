# Copy to .env.local for local development (git-ignored). On Vercel, set these in the
# project's Environment Variables. Leave VITE_API_URL empty to run the site without a backend.

# The Django backend's address, without a trailing slash.
VITE_API_URL=http://127.0.0.1:8000

# Google OAuth client ID (the same value as the backend's GOOGLE_CLIENT_ID). TODO: create it.
VITE_GOOGLE_CLIENT_ID=

# 1 = show the test sign-in form (development builds only; the backend needs DEV_LOGIN=1).
VITE_DEV_LOGIN=1
