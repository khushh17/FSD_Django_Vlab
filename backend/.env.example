# Copy to backend/.env for local development. backend/.env is git-ignored: never commit it.
# The passwords below are DEMO values so the project runs straight away; change them in
# your own backend/.env if anyone else can reach your computer.

DJANGO_DEBUG=1
# Leave empty locally; on the server set a long random value.
DJANGO_SECRET_KEY=
# Comma-separated. On the server: the backend's own domain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Empty = SQLite file (backend/db.sqlite3). On the server: the Neon pooled connection string,
# set by Vercel when the database is connected (never paste it into chat or commit it).
DATABASE_URL=

# The lab site's address(es), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin account for the admin pages (#/admin), created by `manage.py seed_demo`.
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=admin-demo-123

# Class password: every student signs in with their roll number and this password.
# Empty switches student sign-in off.
STUDENT_SHARED_PASSWORD=class-demo-123
