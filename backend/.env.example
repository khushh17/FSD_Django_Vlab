# Copy to backend/.env for local development. backend/.env is git-ignored: never commit it.

DJANGO_DEBUG=1
# Leave empty locally; on the server set a long random value.
DJANGO_SECRET_KEY=
# Comma-separated. On the server: the backend's own domain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Empty = SQLite file (backend/db.sqlite3). On the server: the Neon pooled connection string,
# set by Vercel when the database is connected (never paste it into chat or commit it).
DATABASE_URL=

# The lab site's address(es), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google sign-in. TODO: create an OAuth client ID in Google Cloud Console.
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAIN=somaiya.edu

# 1 = enable POST /api/auth/dev to sign in as any email without Google (only works with DJANGO_DEBUG=1).
DEV_LOGIN=1

# Local admin account created by `manage.py seed_demo` (development only; set any values).
DEV_ADMIN_USERNAME=
DEV_ADMIN_PASSWORD=

# Roll-number sign-in: the one password every student uses with their roll number.
# Choose your own; empty switches roll-number sign-in off.
STUDENT_SHARED_PASSWORD=
